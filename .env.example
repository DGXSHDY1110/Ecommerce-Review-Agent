# =============================================================================
# Ecommerce Review Agent — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.
# =============================================================================

# DeepSeek API (required for real LLM mode)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Mock mode toggle (V2-M1: canonical name)
# Set to true ONLY for explicit test/demo mock mode.
# When false (default) and DEEPSEEK_API_KEY is missing, the service will
# report an error instead of silently switching to mock.
USE_MOCK_LLM=false

# Legacy alias for USE_MOCK_LLM (still supported but deprecated)
# LLM_MOCK_MODE=false

# LLM client tuning
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# Guardrail thresholds
CONFIDENCE_THRESHOLD=0.6
LOW_RATING_THRESHOLD=2

# Observability
LOG_LEVEL=INFO

# FastAPI server
APP_HOST=0.0.0.0
APP_PORT=8000

# Feishu webhook (optional, for notification integration)
FEISHU_WEBHOOK_URL=your_feishu_webhook_url_here
